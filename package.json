{
  "name": "@pawka/price-bot",
  "description": "A small Telegram bot that fetches fiat and crypto exchange rates on a schedule and posts them to a chat",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node --use-env-proxy src/main.js",
    "start:prod": "node --use-env-proxy src/main.js",
    "start:dev": "node --use-env-proxy --watch src/main.js",
    "test": "LOG_LEVEL=silent node --test 'test/**/*.test.js'",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.52.0",
    "cron": "^4.4.0",
    "env-var": "^7.5.0",
    "grammy": "^1.39.3",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "undici": "^7.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/node": "^25.2.2"
  },
  "packageManager": "yarn@4.11.0"
}
